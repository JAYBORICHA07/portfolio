---
import { Icon } from "astro-icon/components";
import CopyEmail from "./CopyEmail.astro";
import { RESUME, SOCIALS } from "../lib/constants";
---

<section aria-labelledby="contact-heading" class="card max-w-[720px] p-6 sm:p-8 lg:p-12">
  <h2 id="contact-heading" class="text-section font-650 text-fg">Let's build something.</h2>
  <p class="mt-3 max-w-text text-lead text-muted">
    Open to AI engineering roles — product or services — and to consulting on LLM workflows and automation. Email is
    fastest; I reply within a day.
  </p>

  <div class="mt-8">
    <CopyEmail variant="block" />
  </div>

  <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-small">
    {
      SOCIALS.map(({ label, href }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1 text-muted transition-colors duration-160 ease-standard @hover:text-accent">
            {label}
            <Icon name="ri:arrow-right-up-line" class="h-3.5 w-3.5 transition-transform duration-200 ease-out group-hover:translate-x-px group-hover:-translate-y-px" />
          </a>
        </li>
      ))
    }
    <li>
      <a href={RESUME} class="group inline-flex items-center gap-1 text-muted transition-colors duration-160 ease-standard @hover:text-accent">
        Resume
        <Icon name="ri:arrow-right-up-line" class="h-3.5 w-3.5 transition-transform duration-200 ease-out group-hover:translate-x-px group-hover:-translate-y-px" />
      </a>
    </li>
  </ul>
</section>
