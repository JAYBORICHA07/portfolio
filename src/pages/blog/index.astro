---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/Blog/PostRow.astro";
import { LINKS, SITE } from "../../lib/constants";

const entries = (await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

// Reading time is produced by the remark plugin and only surfaces via render().
const posts = await Promise.all(
  entries.map(async (post) => {
    const { remarkPluginFrontmatter } = await post.render();
    return { post, minutesRead: remarkPluginFrontmatter.minutesRead as string | undefined };
  }),
);
---

<BaseLayout
  title={`Writing · ${SITE.name}`}
  description="Notes by Jay Boricha on TypeScript, APIs, and the tools he builds with."
>
  <div class="container-page pt-10 md:pt-16">
    <div class="max-w-[720px]">
      <h1 class="text-title font-700 text-fg">Writing</h1>
      <p class="mt-4 max-w-text text-lead text-muted">Notes on TypeScript, APIs and the tools I build with.</p>

      <ul class="mt-10 border-t border-line md:mt-14">
        {
          posts.map(({ post, minutesRead }) => (
            <PostRow
              title={post.data.title}
              description={post.data.description}
              date={post.data.pubDate}
              url={`/blog/${post.slug}`}
              category={post.data.category}
              minutesRead={minutesRead}
            />
          ))
        }
      </ul>

      <p class="mt-8 text-small text-muted">
        I also post on
        <a href={LINKS.devto} target="_blank" rel="noopener noreferrer" class="link-accent">dev.to ↗</a>
      </p>
    </div>
  </div>
</BaseLayout>
