---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { projects } from "../../data/projects";
import { SITE } from "../../lib/constants";
---

<BaseLayout
  title={`Projects · ${SITE.name}`}
  description="What Jay Boricha is building — practical AI workflows: document extraction, a RAG assistant with citations, a tool-calling ops agent, inbox automation, LLM-assisted reconciliation, and an eval harness."
>
  <div class="container-page pt-10 md:pt-16">
    <h1 class="text-title font-700 text-fg">Projects</h1>
    <p class="mt-4 max-w-text text-lead text-muted">
      Six practical AI workflows — one for each way a business actually wants to use a model — each with evals and a
      human in the loop where the stakes justify it.
    </p>
    <p class="mt-3 max-w-text text-small text-subtle">Work in progress — code and demos appear here as each one ships.</p>

    <ul class="mt-10 border-t border-line md:mt-14">
      {projects.map((project, i) => <ProjectRow project={project} index={i} variant="full" first={i === 0} />)}
    </ul>
  </div>
</BaseLayout>
